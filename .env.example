# =============================================================================
# video-server 服务监听
# =============================================================================

# 监听地址。0.0.0.0 表示允许其他机器访问；只允许本机访问可改为 127.0.0.1。
HOST=0.0.0.0

# video-server 的 REST、SSE 和 MCP 共用此端口。
PORT=8090

# video-server 外部接口的 Bearer Token。
# Agent 的 MCP/REST 客户端使用这个密钥，它与 llm-gateway 的密钥没有配对关系。
# 生产环境不要使用示例值；留空会关闭鉴权，仅适合本机开发。
VIDEO_SERVER_API_KEY=change-me

# =============================================================================
# ComfyUI
# =============================================================================

# ComfyUI 本地服务地址。video-server 会调用 /prompt、/ws、/history 和 /view。
COMFYUI_BASE_URL=http://127.0.0.1:8188

# 单个 ComfyUI 任务的最长等待时间，单位毫秒；示例为 30 分钟。
COMFY_JOB_TIMEOUT_MS=1800000

# video-server 同时处理的生成任务数。同一块 GPU 初期建议保持 1。
JOB_CONCURRENCY=1

# video-server 看到的 ComfyUI input 目录。配置后优先使用 NAS/本地硬链接或复制快路径。
# 留空则通过 ComfyUI /upload/image 上传输入文件。
COMFY_INPUT_ROOT=/opt/ComfyUI/input

# video-server 看到的 ComfyUI output 目录。配置后直接从本地路径导入生成结果。
# 留空则通过 ComfyUI /view 下载结果后上传到当前资源后端。
COMFY_OUTPUT_ROOT=/opt/ComfyUI/output

# =============================================================================
# 工作流与任务持久化
# =============================================================================

# ComfyUI 导出的 API Format Workflow JSON 所在目录。
# 相对路径基于 PM2 ecosystem.config.cjs 的 cwd，也就是当前项目目录。
WORKFLOW_DIR=./workflows

# video-server 自定义的 *.manifest.json 所在目录。
# manifest 中的 workflowFile 不相对此目录，而是始终相对 WORKFLOW_DIR 解析。
# 留空时兼容旧配置：使用 WORKFLOW_DIR，因此两类文件也可以继续放在一起。
# MANIFEST_DIR=./manifests

# 持久化任务 JSON 的目录。服务重启后会恢复 queued/running 任务。
JOB_DATA_DIR=./data/jobs

# 下载和转换输入文件时使用的临时目录，任务结束后会自动清理。
JOB_TEMP_DIR=./tmp/jobs

# =============================================================================
# 媒体资源后端
# =============================================================================

# llm_gateway 保留旧资产服务；runclave 直接消费 runclave-resource:// 并将输出注册回 Runclave。
MEDIA_RESOURCE_BACKEND=runclave

# Runclave API 地址及可选 Desktop token。
RUNCLAVE_RESOURCE_BASE_URL=http://macmini.shenshen:3001
RUNCLAVE_RESOURCE_API_TOKEN=

# 必须与 Runclave shared_fs 的 providerId 和 NAS 根目录一致。
# video-server 会在该目录写入短期 staging 文件，Runclave 注册为内容寻址对象后立即清理。
RUNCLAVE_SHARED_PROVIDER_ID=nas_main
RUNCLAVE_SHARED_ROOT=/Volumes/media/runclave

# =============================================================================
# llm-gateway 旧资产服务（仅 MEDIA_RESOURCE_BACKEND=llm_gateway 时使用）
# =============================================================================

# video-server 能访问到的 llm-gateway 地址。
# 其中端口应与 llm-gateway 的 PORT 一致；跨容器时不要使用 127.0.0.1。
ASSET_SERVICE_URL=http://127.0.0.1:8080

# 调用 llm-gateway 外部 /assets 接口时使用的 Bearer Token。
# 必须与 llm-gateway 的 GATEWAY_API_KEY 保持一致。
ASSET_SERVICE_API_KEY=change-me

# 调用 llm-gateway /internal/assets/* 快路径接口时使用的密钥。
# 必须与 llm-gateway 的 INTERNAL_API_KEY 保持一致。
ASSET_INTERNAL_API_KEY=change-internal-key

# 多租户 Token 映射；单租户也可继续使用 VIDEO_SERVER_API_KEY。
VIDEO_SERVER_USERS={}

# MCP/Agent 图片预览短期 URL 的 HMAC 签名密钥。不要外泄。
ASSET_URL_SIGNING_SECRET=

# 签名 URL 有效期，默认 24 小时。
ASSET_URL_TTL_SECONDS=60

# 配置为 Agent 和浏览器能够访问到的 video-server 地址后，MCP 才会签发预览 URL。
VIDEO_SERVER_PUBLIC_BASE_URL=https://video-server.shenshen
